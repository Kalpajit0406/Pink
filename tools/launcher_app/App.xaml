<Application x:Class="LeonidaLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Windows 11 Fluent Dark Theme Colors (Matching LuaTools Style) -->
        <Color x:Key="Win11BgColor">#161217</Color>
        <Color x:Key="Win11SidebarColor">#110D12</Color>
        <Color x:Key="Win11CardColor">#211B23</Color>
        <Color x:Key="Win11CardHoverColor">#29222C</Color>
        <Color x:Key="Win11BorderColor">#362B39</Color>
        <Color x:Key="Win11AccentPurpleColor">#C026D3</Color>
        <Color x:Key="Win11AccentPinkColor">#E11D48</Color>
        <Color x:Key="Win11AccentCyanColor">#06B6D4</Color>
        <Color x:Key="Win11TextPrimaryColor">#F4F3F6</Color>
        <Color x:Key="Win11TextSecondaryColor">#A098A4</Color>

        <SolidColorBrush x:Key="Win11Bg" Color="{StaticResource Win11BgColor}" />
        <SolidColorBrush x:Key="Win11Sidebar" Color="{StaticResource Win11SidebarColor}" />
        <SolidColorBrush x:Key="Win11Card" Color="{StaticResource Win11CardColor}" />
        <SolidColorBrush x:Key="Win11CardHover" Color="{StaticResource Win11CardHoverColor}" />
        <SolidColorBrush x:Key="Win11Border" Color="{StaticResource Win11BorderColor}" />
        <SolidColorBrush x:Key="Win11AccentPurple" Color="{StaticResource Win11AccentPurpleColor}" />
        <SolidColorBrush x:Key="Win11AccentPink" Color="{StaticResource Win11AccentPinkColor}" />
        <SolidColorBrush x:Key="Win11AccentCyan" Color="{StaticResource Win11AccentCyanColor}" />
        <SolidColorBrush x:Key="Win11TextPrimary" Color="{StaticResource Win11TextPrimaryColor}" />
        <SolidColorBrush x:Key="Win11TextSecondary" Color="{StaticResource Win11TextSecondaryColor}" />

        <!-- Windows 11 Primary Launch Button -->
        <Style x:Key="Win11LaunchButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#C026D3" Offset="0" />
                        <GradientStop Color="#E11D48" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#D946EF" Offset="0" />
                                            <GradientStop Color="#F43F5E" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#2D2630" />
                                <Setter Property="Foreground" Value="#6A626F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Secondary Action Button -->
        <Style x:Key="Win11Button" TargetType="Button">
            <Setter Property="Background" Value="#2A222C" />
            <Setter Property="Foreground" Value="{StaticResource Win11TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Win11Border}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#382E3B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1A151C" />
                                <Setter Property="Foreground" Value="#554E57" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 Card Panel -->
        <Style x:Key="Win11CardPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Win11Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Win11Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Windows 11 Slider Style -->
        <Style x:Key="Win11Slider" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Win11AccentPurple}" />
        </Style>

    </Application.Resources>
</Application>
